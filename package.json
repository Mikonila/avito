  "version": "1.0.0",
  "description": "Telegram Mini App Marketplace for Montenegro",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "bot": "node bot.js",
    "init-db": "node backend/init-db.js",
    "seed-db": "node backend/seed-db.js",
    "backup": "node scripts/backup.js",
    "clean-logs": "node scripts/clean-logs.js",
    "stats": "node scripts/stats.js",
    "health": "node scripts/health-check.js",
    "deploy-full": "node deploy/deploy-full.js",
    "deploy-minimal": "node deploy/deploy-minimal.js",
